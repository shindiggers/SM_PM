<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_rollover_reset_tag"
        android:backgroundTint="?android:attr/textColorSecondary"
        android:alpha="0.4" />

    <!-- Sheet Title -->
    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="16dp"
        android:text="@string/BUDGETS_ADD_INTERVAL" />

    <!-- Dates Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="12dp">

        <!-- From Date -->
        <LinearLayout
            android:id="@+id/sheet_from_date_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/list_selector_bg_white"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/BUDGETS_START_DATE"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/sheet_from_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginTop="4dp"
                tools:text="01/01/2026" />
        </LinearLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <!-- To Date -->
        <LinearLayout
            android:id="@+id/sheet_to_date_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/list_selector_bg_white"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/BUDGETS_END_DATE"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/sheet_to_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginTop="4dp"
                tools:text="Ongoing" />
        </LinearLayout>

    </LinearLayout>

    <!-- Ongoing Checkbox -->
    <CheckBox
        android:id="@+id/sheet_ongoing_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/BUDGETS_ONGOING_CHECKBOX"
        android:checked="true"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="16dp" />

    <!-- Budget Amount -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/BUDGETS_AMOUNT"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/sheet_amount_edittext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="@string/exhcangerate_amount_hint"
        android:inputType="numberDecimal"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:background="@drawable/list_selector_bg_white"
        android:padding="10dp"
        android:layout_marginBottom="16dp"
        android:importantForAutofill="no" />

    <!-- Reset Rollover Checkbox -->
    <CheckBox
        android:id="@+id/sheet_reset_rollover_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/BUDGETS_ROLLOVER_RESET_LABEL"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="24dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_cancel_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="105dp"
            android:minHeight="44dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/GENERAL_CANCEL"
            android:textSize="14sp"
            android:layout_marginEnd="12dp"
            app:cornerRadius="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_apply_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="105dp"
            android:minHeight="44dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/GENERAL_OK"
            android:textSize="14sp"
            app:cornerRadius="22dp" />

    </LinearLayout>

</LinearLayout>
