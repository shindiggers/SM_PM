<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/therow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/chart_compose_container"
                android:layout_width="match_parent"
                android:layout_height="250dp" />

            <FrameLayout
                android:id="@+id/period_selector_container"
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <ImageView
                    android:id="@+id/lefttarrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="@string/earlier_period"
                    android:src="@drawable/leftarrow" />

                <Button
                    android:id="@+id/periodbutton"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    tools:text="mmmm yyyy" />

                <ImageView
                    android:id="@+id/rightarrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:contentDescription="@string/later_period"
                    android:src="@drawable/rightarrow" />

            </FrameLayout>

            <ListView
                android:id="@+id/thelist"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/empty_chart_state_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/empty_chart_icon_container"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/empty_chart_icon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_charts"
                    android:alpha="0.5"
                    app:tint="?android:attr/textColorSecondary"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:contentDescription="@string/no_data_for_this_period"/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:color/transparent">
            </FrameLayout>

            <LinearLayout
                android:id="@+id/empty_state_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0"
                android:gravity="center"
                android:background="?android:colorBackground">

                <TextView
                    android:id="@+id/empty_state_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_data_for_this_period"
                    android:textSize="18sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/balance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kLOC_REPORT_EXPENSETOTAL"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/balance_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/_0_0_report_balance_placeholder"
            android:textStyle="bold"
            tools:text="-£2,000.00" />

    </LinearLayout>

</LinearLayout>
