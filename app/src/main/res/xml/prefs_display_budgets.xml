<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/GENERAL_REPORTS">

    <Preference
        android:key="budgetChooseAccounts"
        android:title="@string/BUDGET_ACCOUNTS_TITLE"
        android:summary="@string/BUDGET_ACCOUNTS_SUMMARY" />

    <Preference
        android:key="budgetChooseCategories"
        android:title="@string/BUDGET_CATEGORIES_TITLE"
        android:summary="@string/BUDGET_CATEGORIES_SUMMARY" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="budgetShowCents"
        android:title="@string/BUDGET_SHOWCENTS" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="budgetShowUnbudgeted"
        android:title="@string/BUDGET_SHOWUNBUDGETED"
        android:summary="@string/BUDGET_SHOW_UNBUDGETED_SUMMARY" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="budgetIncludeUnbudgeted"
        android:title="@string/BUDGET_INCLUDEUNBUDGETED"
        android:summary="@string/BUDGET_INCLUDE_UNBUDGETED_SUMMARY" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="budgetHideZeros"
        android:title="@string/BUDGETS_HIDEZEROACTUALS" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:key="budgetIncludeTransfers"
        android:title="@string/BUDGETS_INCLUDETRANSFER" />

</PreferenceScreen>
