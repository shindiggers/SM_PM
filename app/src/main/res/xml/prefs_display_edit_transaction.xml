<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/EDIT_TRANSACTION_TITLE">

    <ListPreference
        android:defaultValue="@string/GENERAL_NONE"
        android:key="prefsdisplayeditstartediting"
        android:title="@string/TRANSACTIONS_OPTIONS_STARTEDIT" />

    <PreferenceCategory>
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="prefsuselastdate"
            android:title="@string/PREFERENCES_USE_LAST_DATE"
            app:singleLineTitle="false" />
        <CheckBoxPreference
            android:key="prefsmanagedlistsautofill"
            android:title="@string/PREFERENCES_AUTOFILL" />
        <CheckBoxPreference
            android:key="prefsautosuggest"
            android:title="@string/PREFERENCES_AUTOSUGGEST" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/TRANSACTIONS_OPTIONS_SHOW">

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="prefsdisplayedittime"
            android:title="@string/GENERAL_TIME" />

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="prefsdisplayedittransferandpayee"
            android:title="@string/TRANSACTIONS_OPTIONS_TRANSTOANDTO" />

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="prefsdisplayeditcategory"
            android:title="@string/GENERAL_CATEGORY" />

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="prefsdispplayeditcatposition"
            android:title="@string/PREFERENCES_CAT_ABOVE_PAYEE" />

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="prefsdisplayeditid"
            android:title="@string/GENERAL_ID" />

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="prefsdisplayeditcleared"
            android:title="@string/GENERAL_CLEARED" />

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="prefsdisplayeditmemo"
            android:title="@string/GENERAL_NOTE" />

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="prefsdisplayeditclass"
            android:title="@string/GENERAL_CLASS" />

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="prefsdisplayeditunlink"
            android:title="@string/TRANSACTIONS_OPTIONS_UNLINKID" />

    </PreferenceCategory>

</PreferenceScreen>
